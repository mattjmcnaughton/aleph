#!/usr/bin/env bash
set -euo pipefail

# Amp runs this automatically when creating a fresh orb. Other agents and IDEs
# (including Cursor) do not recognize the `.agents` lifecycle automatically,
# but can use this script as a starting point by running it manually.
#
# Prerequisites, in order:
#   1. Debian 12 with bash, curl, sudo, systemd, and outbound internet access.
#   2. A checkout of this repository (the checkout path does not matter).
#   3. Run `.agents/setup` once; it installs and configures the remaining tools.
#   4. After machine sleep/restart, run `.agents/resume` to restore services.
#   5. Start Keycloak when needed with `just compose-keycloak-up`.
#
# This is Linux-specific because it uses apt and systemd. On macOS or Windows,
# run it inside a Debian dev container or VM rather than directly on the host.

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

export PATH="$HOME/.local/bin:$PATH"

step() {
    local label="$1"
    shift
    local started=$SECONDS
    printf '\n==> %s\n' "$label"
    "$@"
    printf '    completed in %ss\n' "$((SECONDS - started))"
}

install_system_packages() {
    local packages=(docker.io postgresql postgresql-client)
    local missing=()
    local package

    for package in "${packages[@]}"; do
        if ! dpkg-query -W -f='${Status}' "$package" 2>/dev/null | grep -q '^install ok installed$'; then
            missing+=("$package")
        fi
    done

    if ((${#missing[@]})); then
        sudo apt-get update
        sudo DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "${missing[@]}"
    else
        echo "System packages already installed"
    fi
}

install_node() (
    local required_major=22
    local required_minor=13
    local installed_major=0
    local installed_minor=0

    if command -v node >/dev/null 2>&1; then
        IFS=. read -r installed_major installed_minor _ <<<"$(node --version | sed 's/^v//')"
    fi

    if ((installed_major > required_major || (installed_major == required_major && installed_minor >= required_minor))); then
        echo "$(node --version) already satisfies Node >=22.13"
        return
    fi

    local sums archive expected temp_dir
    sums="$(mktemp)"
    temp_dir="$(mktemp -d)"
    trap 'rm -rf "$sums" "$temp_dir"' EXIT
    curl -fsSL https://nodejs.org/dist/latest-v22.x/SHASUMS256.txt -o "$sums"
    archive="$(awk '$2 ~ /^node-v22\..*-linux-x64\.tar\.xz$/ { print $2; exit }' "$sums")"
    if [[ -z "$archive" ]]; then
        echo "Could not identify the latest Node 22 Linux archive" >&2
        return 1
    fi
    expected="$(awk -v archive="$archive" '$2 == archive { print $1 }' "$sums")"
    curl -fsSL "https://nodejs.org/dist/latest-v22.x/$archive" -o "$temp_dir/$archive"
    printf '%s  %s\n' "$expected" "$temp_dir/$archive" | sha256sum --check --status
    tar -xJf "$temp_dir/$archive" -C "$temp_dir"

    rm -rf "$HOME/.local/share/node-v22"
    mkdir -p "$HOME/.local/share" "$HOME/.local/bin"
    mv "$temp_dir/${archive%.tar.xz}" "$HOME/.local/share/node-v22"
    for executable in node npm npx corepack; do
        ln -sfn "$HOME/.local/share/node-v22/bin/$executable" "$HOME/.local/bin/$executable"
    done
    hash -r
    node --version
)

install_uv() {
    if ! command -v uv >/dev/null 2>&1; then
        curl -LsSf https://astral.sh/uv/install.sh | sh
        hash -r
    fi
    uv --version
}

install_just() {
    if ! command -v just >/dev/null 2>&1; then
        mkdir -p "$HOME/.local/bin"
        curl --proto '=https' --tlsv1.2 -sSf https://just.systems/install.sh |
            bash -s -- --to "$HOME/.local/bin"
        hash -r
    fi
    just --version
}

install_pnpm() {
    local wanted=10.33.0
    local installed=""
    installed="$(pnpm --version 2>/dev/null || true)"
    if [[ "$installed" != "$wanted" ]]; then
        npm install --global --prefix "$HOME/.local" "pnpm@$wanted"
        hash -r
    fi
    pnpm --version
}

configure_docker() {
    # The executor user is already in its primary `user` group. Giving the
    # disposable orb's Docker socket that group makes Compose usable immediately,
    # without waiting for a new login to pick up supplementary group changes.
    sudo mkdir -p /etc/systemd/system/docker.socket.d
    printf '[Socket]\nSocketGroup=user\nSocketMode=0660\n' |
        sudo tee /etc/systemd/system/docker.socket.d/orb.conf >/dev/null
    sudo systemctl daemon-reload
    sudo systemctl enable --now docker.socket docker.service >/dev/null
    docker version --format '{{.Server.Version}}'
}

install_docker_compose() (
    if docker compose version >/dev/null 2>&1; then
        docker compose version
        return
    fi

    local asset=docker-compose-linux-x86_64
    local base=https://github.com/docker/compose/releases/latest/download
    local expected temp_dir
    temp_dir="$(mktemp -d)"
    trap 'rm -rf "$temp_dir"' EXIT

    curl -fsSL "$base/$asset" -o "$temp_dir/$asset"
    curl -fsSL "$base/checksums.txt" -o "$temp_dir/checksums.txt"
    expected="$(awk -v asset="$asset" '$2 == asset || $2 == "*" asset { print $1 }' "$temp_dir/checksums.txt")"
    if [[ -z "$expected" ]]; then
        echo "Could not find the Docker Compose checksum" >&2
        return 1
    fi
    printf '%s  %s\n' "$expected" "$temp_dir/$asset" | sha256sum --check --status

    mkdir -p "$HOME/.docker/cli-plugins"
    install -m 0755 "$temp_dir/$asset" "$HOME/.docker/cli-plugins/docker-compose"
    docker compose version
)

configure_postgres() {
    sudo systemctl enable --now postgresql >/dev/null

    local config
    config="$(sudo -u postgres psql -Atqc 'SHOW config_file')"
    for setting in "fsync = off" "synchronous_commit = off"; do
        if ! sudo grep -Fqx "$setting" "$config"; then
            printf '\n%s\n' "$setting" | sudo tee -a "$config" >/dev/null
        fi
    done
    sudo systemctl restart postgresql

    sudo -u postgres psql -v ON_ERROR_STOP=1 <<'SQL'
ALTER USER postgres PASSWORD 'postgres';
SELECT 'CREATE DATABASE aleph'
WHERE NOT EXISTS (SELECT FROM pg_database WHERE datname = 'aleph')\gexec
SQL
}

install_dependencies() {
    uv python install 3.12
    uv sync --dev --frozen
    pnpm install --frozen-lockfile
    pnpm --dir src/aleph/web/frontend install --frozen-lockfile
}

step "Install system packages" install_system_packages
step "Install Node 22" install_node
step "Install uv" install_uv
step "Install just" install_just
step "Install pnpm 10.33.0" install_pnpm
step "Configure Docker" configure_docker
step "Install Docker Compose" install_docker_compose
step "Configure PostgreSQL" configure_postgres

step "Install locked project dependencies" install_dependencies

echo
echo "Orb setup complete. Start Keycloak on demand with: just compose-keycloak-up"
