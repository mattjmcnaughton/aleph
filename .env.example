LOG_LEVEL=INFO
LOG_FORMAT=console
HOST=0.0.0.0
PORT=8000
# Optional secondary OTLP collector (gRPC). Leave unset in dev/CI — with no
# collector listening, an enabled endpoint only produces connection-refused spam.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# Logfire write token (prod only; unset = telemetry no-op).
# LOGFIRE_TOKEN=
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/aleph

# --- OIDC / auth (dev) ---------------------------------------------------
# Matches the checked-in Keycloak dev realm (docker/keycloak/aleph-realm.json)
# served by `just compose-keycloak-up` (Keycloak on localhost:18080). The
# app-side auth wiring (login/callback/session) lands in AL-020; these values
# are the contract that ticket consumes. `aleph-dev-secret` is a well-known
# dev-only secret — never a real credential.
OIDC_PROVIDER=keycloak
OIDC_ISSUER=http://127.0.0.1:18080/realms/aleph
OIDC_CLIENT_ID=aleph
OIDC_CLIENT_SECRET=aleph-dev-secret
# Session cookie signing key (AL-020 reads this; any long random string in dev)
SESSION_SECRET_KEY=dev-session-secret-change-me
# Email domains whose users are admins (TDD §7 derived admin)
ADMIN_EMAIL_DOMAINS=mattjmcnaughton.com

